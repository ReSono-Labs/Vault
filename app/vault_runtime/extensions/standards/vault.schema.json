{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.resonolabs.com/vault/plugin/v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "minimumVaultVersion", "agents"],
  "properties": {
    "$schema": {"const": "https://schemas.resonolabs.com/vault/plugin/v1.json"},
    "minimumVaultVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "agents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["voice", "background"]}},
    "configuration": {"type": "string", "const": "config.schema.json"},
    "mcp": {"type": "string", "const": "mcp.json"},
    "services": {"type": "array", "uniqueItems": true, "items": {"enum": ["memory.search", "memory.propose", "context.locale", "activity.report"]}},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "target"],
          "properties": {
            "source": {"type": "string", "minLength": 1, "maxLength": 256},
            "target": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "target"],
          "properties": {
            "source": {"type": "string", "minLength": 1, "maxLength": 256},
            "target": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "onConflict": {"type": "string", "enum": ["ask", "replace", "skip-if-exists"], "default": "ask"}
      }
    },
    "workspaceImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "onConflict": {"type": "string", "enum": ["ask", "replace", "skip-if-exists"], "default": "ask"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "kind"],
            "properties": {
              "source": {"type": "string", "minLength": 1, "maxLength": 256},
              "target": {"type": "string", "minLength": 0, "maxLength": 256},
              "kind": {"type": "string", "enum": ["file", "directory"]},
              "onConflict": {"type": "string", "enum": ["ask", "replace", "skip-if-exists"]}
            }
          }
        }
      }
    },
    "localShare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mountName"],
      "properties": {
        "mountName": {"type": "string", "minLength": 1, "maxLength": 64},
        "permission": {"type": "string", "enum": ["read", "write"], "default": "read"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "required": {"type": "boolean", "default": false}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supervised": {"type": "boolean", "default": false},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "cwd": {"type": "string", "default": "."},
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535, "default": 8790},
            "healthPath": {"type": "string", "default": "/health"}
          }
        }
      }
    }
  }
}
