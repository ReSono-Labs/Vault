{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.resonolabs.com/vault/mcp-package/v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "runtime"],
  "properties": {
    "$schema": {"const": "https://schemas.resonolabs.com/vault/mcp-package/v1.json"},
    "name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "description": {"type": "string", "maxLength": 512},
    "configuration": {"type": "string", "const": "config.schema.json"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command", "port", "mcpPath"],
      "properties": {
        "type": {"enum": ["process"]},
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "cwd": {"type": "string", "maxLength": 256},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "healthPath": {"type": "string", "pattern": "^/.*", "maxLength": 256},
        "mcpPath": {"type": "string", "pattern": "^/.*", "maxLength": 256}
      }
    },
    "companionPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "maxLength": 64},
        "removeWithPackage": {"type": "boolean", "default": true}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "target"],
          "properties": {
            "source": {"type": "string", "minLength": 1, "maxLength": 256},
            "target": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "target"],
          "properties": {
            "source": {"type": "string", "minLength": 1, "maxLength": 256},
            "target": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "onConflict": {
          "type": "string",
          "enum": ["ask", "replace", "skip-if-exists"],
          "default": "ask"
        }
      }
    }
  }
}
