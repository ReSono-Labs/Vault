# Build context = only what the Dockerfile copies. Everything else is excluded.
*

!pyproject.toml
!uv.lock
!README.md
!LICENSE
!NOTICE
!app/
!frontend/
!plugin-kit/
!integrations/
!docs/
!packaging/
packaging/*
!packaging/local-embeddings/

# Never in the context, even inside the folders above.
**/__pycache__
**/*.pyc
**/*.pyo
**/node_modules
**/.pytest_cache
**/*.egg-info
.env*
**/.env*
*.pem
**/*.pem
*.key
**/*.key
frontend/dist
docs/archive
docs/assets
docs/cleanup
.git
.dci
.superpowers
.kiro
.runtime
.venv
release
